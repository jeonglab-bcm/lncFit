# lncFit pipeline: raw data -> feature vectors -> trained/evaluated model.
#
# Top-to-bottom. Dashed border/edges = only active when features.type: dnabert2.
# The two "worked example" boxes show real (kmer) / illustrative (dnabert2)
# numbers for one actual lncRNA (Hum_XLOC_000002) so the vector construction
# isn't just an abstract box.
#
# Render: d2 docs/diagrams/pipeline.d2 docs/diagrams/pipeline.svg

direction: down

classes: {
  title-lg: {
    style.font-size: 20
    style.bold: true
  }
  node-lg: {
    style.font-size: 15
  }
  example: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
    style.font-size: 15
  }
  optional: {
    style.stroke-dash: 4
  }
}

raw_and_prep: "1. Raw data + preprocessing (outside the pipeline)" {
  class: title-lg
  style.fill: "#eef2f7"
  direction: right

  gtf_fasta: "GTF + FASTA\n(hg19/GRCh37)" {shape: cylinder; class: node-lg}
  rra_excel: "RRA screen\nresults (Excel)" {shape: cylinder; class: node-lg}
  sequence_py: "sequence.py\nparse_gtf() +\nextract_body_seqs()" {class: node-lg}
  screen_data_py: "screen_data.py\nhit calling:\np<0.05, fc<0" {class: node-lg}
  embed_script: "embed_sequences.py\nDNABERT-2, mean-pool" {class: [node-lg; optional]}
  celligner: "Celligner\nre-alignment" {class: node-lg}

  gtf_fasta -> sequence_py
  rra_excel -> screen_data_py
}

artifacts: "2. On-disk artifacts" {
  class: title-lg
  style.fill: "#eef2f7"
  direction: right

  body_seqs: "body_seqs.json\n{target: (first, last)}" {shape: cylinder; class: node-lg}
  train_jsonl: "train_*.jsonl.gz" {shape: cylinder; class: node-lg}
  test_jsonl: "test_*.jsonl.gz" {shape: cylinder; class: node-lg}
  dnabert2_npz: "dnabert2_body.npz" {shape: cylinder; class: [node-lg; optional]}
  celligner_csv: "celligner_*.csv" {shape: cylinder; class: node-lg}
}

raw_and_prep.sequence_py -> artifacts.body_seqs
raw_and_prep.screen_data_py -> artifacts.train_jsonl
raw_and_prep.screen_data_py -> artifacts.test_jsonl
artifacts.body_seqs -> raw_and_prep.embed_script {class: optional}
raw_and_prep.embed_script -> artifacts.dnabert2_npz {class: optional}
raw_and_prep.celligner -> artifacts.celligner_csv

worked_examples: "3. WORKED EXAMPLE -- gene Hum_XLOC_000002" {
  class: title-lg
  direction: right

  kmer_example: "3a. kmer (k=5)" {
    class: [title-lg; example]
    direction: down

    seq: "1010bp window, first 45nt:\nCCCCGAGCGCGGCTCCAGGACCCCGTCGACCCGGAGCGCTGTCCT...\n5-nt sliding window -> 1006 valid positions" {class: node-lg}

    kmer_table: "counts -> freq  (n = 1006)" {
      shape: sql_table
      class: node-lg
      CCCCG: "3  ->  0.003"
      CCGAG: "4  ->  0.004"
      GCGCG: "1  ->  0.001"
      CGCGG: "2  ->  0.002"
      "...": "1024/1024 5-mers observed"
    }

    vector: "x_kmer =\n[0.003, 0.004, 0.001, 0.002, ..., 0.000]\n1024 dims (1 per vocab k-mer)\nsame vector for every cell_line row" {shape: cylinder; class: node-lg}

    seq -> kmer_table
    kmer_table -> vector
  }

  dnabert_example: "3b. dnabert2 -- illustrative" {
    class: [title-lg; example; optional]
    direction: down

    seq2: "same window, tokenized\n(max_length=512)" {class: node-lg}

    token_table: "tokenizer output (illustrative ids)" {
      shape: sql_table
      class: node-lg
      "[CLS]": "1"
      "CCCCG": "1832"
      "AGCGC": "57"
      "...": "..."
      "[SEP]": "2"
    }

    forward: "last_hidden_state\n(1, ~256 tokens, 768 dims)" {class: node-lg}

    meanpool: "mean-pool over\nnon-pad tokens" {class: node-lg}

    vector2: "x_dnabert =\n[0.183, -0.421, 0.076, ..., 0.002]\n768 dims, precomputed once\nby embed_sequences.py" {class: node-lg; shape: cylinder}

    seq2 -> token_table
    token_table -> forward
    forward -> meanpool
    meanpool -> vector2
  }
}

artifacts.train_jsonl -> worked_examples.kmer_example.seq
artifacts.dnabert2_npz -> worked_examples.dnabert_example.seq2 {class: optional}

feature_assembly: "4. Assemble feature matrix (features.py)" {
  class: title-lg
  style.fill: "#e8f0fe"
  direction: down

  concat: "x_kmer OR x_dnabert2 (pick one)\n+ cell one-hot (5 cols)\n+ Celligner coords (0/2/10/70, optional)\n+ distance-to-gene (optional)" {class: node-lg}

  X_y: "X: (n_rows x n_features)\nkmer, dim=0 -> 1029 cols\ny: binary hit label" {shape: cylinder; class: node-lg}

  concat -> X_y
}

worked_examples.kmer_example.vector -> feature_assembly.concat
worked_examples.dnabert_example.vector2 -> feature_assembly.concat {class: optional}
artifacts.celligner_csv -> feature_assembly.concat

train_eval: "5. Train, tune, evaluate (LncRnaPipeline)" {
  class: title-lg
  style.fill: "#fdece8"
  direction: down

  cv: "make_cv_splits()\nnone / chrom / stratified" {class: node-lg}

  tuning: "tuning.method" {
    direction: right
    class: node-lg
    fixed: "fixed" {class: node-lg}
    grid: "grid\n(itertools.product)" {class: node-lg}
    optuna: "optuna\n(TPE, n_trials)" {class: node-lg}
  }

  registry: "classifiers registry\nxgboost/logreg/rf/knn/mlp/null" {shape: cylinder; class: node-lg}

  fold_fit: "per fold x params:\nfit -> predict_proba -> AUROC/AUPRC" {class: node-lg}

  best_params: "best_params" {class: node-lg}

  final_fit: "refit on ALL\ntraining rows" {class: node-lg}

  eval: "predict_proba(X_test)\nper-cell-line AUROC/AUPRC/F1" {class: node-lg}

  cv -> tuning.fixed
  cv -> tuning.grid
  cv -> tuning.optuna
  tuning.fixed -> fold_fit
  tuning.grid -> fold_fit
  tuning.optuna -> fold_fit
  registry -> fold_fit
  fold_fit -> best_params
  best_params -> final_fit
  registry -> final_fit
  final_fit -> eval
}

feature_assembly.X_y -> train_eval.cv
feature_assembly.X_y -> train_eval.final_fit: "all training rows"
feature_assembly.X_y -> train_eval.eval: "held-out test rows"

save: "6. Saved run (results/.../run_<model>_<timestamp>/)" {
  class: title-lg
  outputs: "config.yaml, best_params.json,\ncv_scores.csv, metrics.csv,\npredictions.csv, run_info.json" {shape: cylinder; class: node-lg}
}

train_eval.eval -> save.outputs
train_eval.best_params -> save.outputs
