# lncFit pipeline: raw data -> feature vectors -> trained/evaluated model.
#
# Top-to-bottom. Dashed border/edges = only active when features.type: dnabert2.
# The two "worked example" boxes show real (kmer) / illustrative (dnabert2)
# numbers for one actual lncRNA (Hum_XLOC_000002) so the vector construction
# isn't just an abstract box.
#
# Render: d2 docs/diagrams/pipeline.d2 docs/diagrams/pipeline.svg

direction: down

classes: {
  title-lg: {
    style.font-size: 22
    style.bold: true
  }
  node-lg: {
    style.font-size: 17
  }
  example: {
    style.fill: "#fff8e1"
    style.stroke: "#f9a825"
    style.font-size: 17
  }
  optional: {
    style.stroke-dash: 4
  }
}

raw_and_prep: "1. Raw data + one-time preprocessing (outside the pipeline)" {
  class: title-lg
  style.fill: "#eef2f7"
  direction: right

  gtf_fasta: "GTF + FASTA\n(hg19 / GRCh37)" {shape: cylinder; class: node-lg}
  rra_excel: "RRA screen results\n(Excel, per cell line)" {shape: cylinder; class: node-lg}
  sequence_py: "lncfit/sequence.py\nparse_gtf()\nextract_body_sequences()" {class: node-lg}
  screen_data_py: "lncfit/screen_data.py\nhit calling:\np<0.05 & fold_change<0 -> label" {class: node-lg}
  embed_script: "scripts/embed_sequences.py\nDNABERT-2-117M, mean-pool\nlast hidden state" {class: [node-lg; optional]}
  celligner: "Celligner re-alignment\n(external, issue #78)" {class: node-lg}

  gtf_fasta -> sequence_py
  rra_excel -> screen_data_py
}

artifacts: "2. On-disk artifacts (pipeline inputs)" {
  class: title-lg
  style.fill: "#eef2f7"
  direction: right

  body_seqs: "body_sequences_transcript.json\n{target: (first1000bp, last1000bp)}" {shape: cylinder; class: node-lg}
  train_jsonl: "train_lncrna_*.jsonl.gz" {shape: cylinder; class: node-lg}
  test_jsonl: "test_lncrna_*.jsonl.gz" {shape: cylinder; class: node-lg}
  dnabert2_npz: "dnabert2_body.npz\n(embedding matrix + target index)" {shape: cylinder; class: [node-lg; optional]}
  celligner_csv: "celligner_cell_line_umap.csv\ncelligner_cell_line_pca.csv" {shape: cylinder; class: node-lg}
}

raw_and_prep.sequence_py -> artifacts.body_seqs
raw_and_prep.screen_data_py -> artifacts.train_jsonl
raw_and_prep.screen_data_py -> artifacts.test_jsonl
artifacts.body_seqs -> raw_and_prep.embed_script: "transcript seqs\n(dnabert2 config only)" {class: optional}
raw_and_prep.embed_script -> artifacts.dnabert2_npz {class: optional}
raw_and_prep.celligner -> artifacts.celligner_csv

kmer_example: "3a. WORKED EXAMPLE -- features.type: kmer (k=5), gene Hum_XLOC_000002" {
  class: [title-lg; example]
  direction: down

  seq: "first 1000bp window (1010bp incl. edges), first 45 shown:\nCCCCGAGCGCGGCTCCAGGACCCCGTCGACCCGGAGCGCTGTCCT...\n\nslide a 5-nt window across the sequence: 1006 valid windows\n(len - k + 1), skipping any window touching an N." {class: node-lg}

  kmer_table: "raw counts -> normalized frequency (count / 1006 total windows)" {
    shape: sql_table
    class: node-lg
    CCCCG: "count = 3   ->   freq = 0.003"
    CCGAG: "count = 4   ->   freq = 0.004"
    GCGCG: "count = 1   ->   freq = 0.001"
    CGCGG: "count = 2   ->   freq = 0.002"
    "... (1020 more of the 1024 possible 5-mers)": "fit_vocab() keeps every k-mer observed anywhere\nin the training set -- here that's 1024/1024 (all of them)"
  }

  vector: "x_kmer(Hum_XLOC_000002) =\n[0.003, 0.004, 0.001, 0.002, ..., 0.000]\n1024 dims, one column per vocab k-mer, alphabetical order.\nSame vector reused for every cell_line row of this gene." {shape: cylinder; class: node-lg}

  seq -> kmer_table
  kmer_table -> vector
}

dnabert_example: "3b. WORKED EXAMPLE -- features.type: dnabert2 (same gene) -- illustrative values" {
  class: [title-lg; example; optional]

  direction: down

  seq2: "same 1010bp window, truncated/padded to the model's\nmax_length=512 tokens by the DNABERT-2 tokenizer" {class: node-lg}

  token_table: "byte-pair tokenizer output (illustrative token ids)" {
    shape: sql_table
    class: node-lg
    "[CLS]": "id = 1"
    "CCCCG": "id = 1832"
    "AGCGC": "id = 57"
    "GGCTC": "id = 941"
    "...": "..."
    "[SEP]": "id = 2"
  }

  forward: "model(**tokens) -> last_hidden_state\nshape (1 sequence, ~256 tokens, 768 dims)\none 768-d vector per token" {class: node-lg}

  meanpool: "mean-pool over the ~256 non-padding token vectors\n(attention_mask marks which tokens are real)" {class: node-lg}

  vector2: "x_dnabert(Hum_XLOC_000002) =\n[0.183, -0.421, 0.076, ..., 0.002]\n768 dims -- one fixed vector per gene, precomputed\nonce by scripts/embed_sequences.py and cached to disk" {shape: cylinder; class: node-lg}

  seq2 -> token_table
  token_table -> forward
  forward -> meanpool
  meanpool -> vector2
}

feature_assembly: "4. Assemble the final feature matrix (lncfit/features.py)" {
  class: title-lg
  style.fill: "#e8f0fe"
  direction: down

  concat: "x_kmer OR x_dnabert2  (features.type picks exactly one)\n  + cell-line one-hot, 5 cols (HAP1/HEK293FT/K562/MDA-MB-231/THP1)\n  + Celligner coords, 0/2/10/70 cols (optional, features.cell_embedding_dim)\n  + distance-to-nearest-protein-coding-gene (optional)" {class: node-lg}

  X_y: "X: (n_rows x n_features)   e.g. kmer, dim=0 -> 1024 + 5 = 1029 cols\ny: binary hit label (1 row per lncRNA x cell_line)" {shape: cylinder; class: node-lg}

  concat -> X_y
}

kmer_example.vector -> feature_assembly.concat
dnabert_example.vector2 -> feature_assembly.concat {class: optional}
artifacts.celligner_csv -> feature_assembly.concat
artifacts.train_jsonl -> kmer_example.seq
artifacts.dnabert2_npz -> dnabert_example.seq2 {class: optional}

train_eval: "5. Train, tune, and evaluate (lncfit.pipeline.LncRnaPipeline)" {
  class: title-lg
  style.fill: "#fdece8"
  direction: down

  cv: "cv.make_cv_splits()\nnone / chrom LOCO / stratified K-fold" {class: node-lg}

  tuning: "tuning.method" {
    direction: right
    class: node-lg
    fixed: "fixed\nmodel.params as-is" {class: node-lg}
    grid: "grid\nitertools.product over\nsearch-space YAML" {class: node-lg}
    optuna: "optuna\nTPE sampler, n_trials" {class: node-lg}
  }

  registry: "lncfit.classifiers registry\nxgboost / logreg / randomforest / knn / mlp / null" {shape: cylinder; class: node-lg}

  fold_fit: "per fold x candidate params:\nmodel.fit(X_train_fold, y_train_fold)\npredict_proba(X_val_fold) -> AUROC or AUPRC" {class: node-lg}

  best_params: "best_params\n(highest mean CV score)" {class: node-lg}

  final_fit: "refit once on ALL training rows\nwith best_params" {class: node-lg}

  eval: "predict_proba(X_test)\nevaluate_lncrna_by_group()\noverall + per-cell-line AUROC/AUPRC/F1/P/R" {class: node-lg}

  cv -> tuning.fixed
  cv -> tuning.grid
  cv -> tuning.optuna
  tuning.fixed -> fold_fit
  tuning.grid -> fold_fit
  tuning.optuna -> fold_fit
  registry -> fold_fit
  fold_fit -> best_params
  best_params -> final_fit
  registry -> final_fit
  final_fit -> eval
}

feature_assembly.X_y -> train_eval.cv
feature_assembly.X_y -> train_eval.final_fit: "all training rows"
feature_assembly.X_y -> train_eval.eval: "held-out test rows (different chromosome)"

save: "6. Saved run (results/.../run_<model>_<timestamp>/)" {
  class: title-lg

  outputs: "config.yaml, best_params.json, cv_scores.csv,\nmetrics.csv, predictions.csv, run_info.json" {shape: cylinder; class: node-lg}
}

train_eval.eval -> save.outputs
train_eval.best_params -> save.outputs
